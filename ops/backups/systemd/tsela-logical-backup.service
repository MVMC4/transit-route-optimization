[Unit]
Description=Tsela verified PostgreSQL logical backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tsela-backup
Group=tsela-backup
EnvironmentFile=/etc/tsela/backup.env
ExecStart=/opt/tsela/ops/backups/logical-backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/tsela
UMask=0077

[Install]
WantedBy=multi-user.target
