FROM node:22-alpine

WORKDIR /app
COPY package*.json ./
RUN --mount=type=cache,id=transitos-docs-npm,target=/root/.npm \
    npm ci --prefer-offline --no-audit --no-fund
COPY . .

ARG NEXT_PUBLIC_API_BASE=http://localhost:8000
ARG NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
ARG NEXT_PUBLIC_DEMO_MODE=false
ARG NEXT_PUBLIC_DEMO_EMAIL=demo@tsela.local
ARG NEXT_PUBLIC_DEMO_PASSWORD=TselaDemo2026!
ENV NEXT_PUBLIC_API_BASE=$NEXT_PUBLIC_API_BASE
ENV NEXT_PUBLIC_MARKETING_URL=$NEXT_PUBLIC_MARKETING_URL
ENV NEXT_PUBLIC_DEMO_MODE=$NEXT_PUBLIC_DEMO_MODE
ENV NEXT_PUBLIC_DEMO_EMAIL=$NEXT_PUBLIC_DEMO_EMAIL
ENV NEXT_PUBLIC_DEMO_PASSWORD=$NEXT_PUBLIC_DEMO_PASSWORD

RUN npm run build

EXPOSE 3003
CMD ["npm", "start"]
