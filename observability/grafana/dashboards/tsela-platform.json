{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "API request rate",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(rate(tsela_http_requests_total[5m]))", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "5xx error rate",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [{ "expr": "sum(rate(tsela_http_requests_total{status=~\"5..\"}[5m]))", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Requests in flight",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [{ "expr": "sum(tsela_http_requests_in_flight)", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Request latency percentiles",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(tsela_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(tsela_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(tsela_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests by route and status",
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 18 },
      "targets": [{ "expr": "sum by (route, status) (rate(tsela_http_requests_total[5m]))", "legendFormat": "{{route}} · {{status}}", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "API resident memory",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 29 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [{ "expr": "process_resident_memory_bytes{job=\"tsela-api\"}", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Database size",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 29 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [{ "expr": "pg_database_size_bytes{job=\"tsela-postgres\",datname=\"transit\"}", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Database connections",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 29 },
      "targets": [{ "expr": "sum(pg_stat_database_numbackends{job=\"tsela-postgres\",datname=\"transit\"})", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Database cache memory",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 37 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [{ "expr": "pg_settings_shared_buffers_bytes{job=\"tsela-postgres\"}", "refId": "A" }]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 41,
  "tags": ["tsela", "api"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "Tsela platform",
  "uid": "tsela-platform",
  "version": 1
}
